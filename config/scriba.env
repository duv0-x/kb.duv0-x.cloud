# Configuración de la instancia kb.duv0-x.cloud (sin secretos). pi/provision.sh la instala en /scriba/scriba.env.
# Scriba no lee el entorno: scriba.service pasa estos valores como flags de `scriba serve`. Sin comentarios al final
# de línea: el valor completo llega al flag.
SCRIBA_LISTEN=127.0.0.1:8090
SCRIBA_PUBLIC_URL=https://kb.duv0-x.cloud
SCRIBA_TZ=America/Bogota
